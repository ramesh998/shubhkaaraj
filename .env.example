# Copy to .env and fill in. Never commit .env.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain used by Caddy in production (docker compose)
DOMAIN=localhost

# --- MongoDB ---
# Local dev (docker compose up -d mongo). Credentials must match the values below.
MONGODB_URI=mongodb://shubhkaaraj:change-me-app@127.0.0.1:27017/shubhkaaraj?authSource=shubhkaaraj
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=shubhkaaraj
MONGO_APP_PASSWORD=change-me-app
MONGO_DB=shubhkaaraj

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-12chars+
ADMIN_NAME=Admin

# --- Media storage ---
# Leave R2_* empty in development: files go to ./uploads and are served from /api/media.
UPLOAD_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain), e.g. https://media.shubhkaaraj.com
NEXT_PUBLIC_MEDIA_URL=

# --- Email (optional in development: emails are printed to the console) ---
RESEND_API_KEY=
MAIL_FROM=ShubhKaaraj <no-reply@example.com>
# Comma-separated list of inboxes that receive new-lead alerts
LEAD_NOTIFY_EMAILS=

# --- Spam protection (optional in development) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
